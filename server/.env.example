# Copy to .env and adjust.

PORT=4000
NODE_ENV=development

# Where the Next.js app runs (CORS + cookie origin).
CLIENT_ORIGIN=http://localhost:3001

# Sign JWTs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Encrypts WhatsApp access tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes stored tokens unreadable — they must be re-entered.
ENCRYPTION_KEY=change_me_to_32_random_bytes_in_hex

# Leave empty to use the embedded PGlite database at ./.data/pgdata (local dev,
# no install needed). Set it to a Supabase/Neon/RDS connection string in
# staging and production:
#   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# WhatsApp delivery driver.
#   mock  - messages stay inside Abiz; use /api/dev/inbound to simulate a customer
#   cloud - real Meta Cloud API calls (needs the per-company token in Settings)
WHATSAPP_DRIVER=mock

# Meta Cloud API. Graph version used for send calls.
META_GRAPH_VERSION=v21.0

# Credentials created by `npm run seed`. Local development only — the seed
# script refuses to run when NODE_ENV=production. Change these before exposing
# the app to anything outside your machine.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin123
SEED_COMPANY_NAME=Abiz Store

# How long a password reset link stays valid.
RESET_TOKEN_TTL_MINUTES=30

# Copy to .env and adjust.

PORT=4000
NODE_ENV=development

# Where the Next.js app runs (CORS + cookie origin).
CLIENT_ORIGIN=http://localhost:3001

# Sign JWTs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Encrypts WhatsApp access tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes stored tokens unreadable — they must be re-entered.
ENCRYPTION_KEY=change_me_to_32_random_bytes_in_hex

# Leave empty to use the embedded PGlite database at ./.data/pgdata (local dev,
# no install needed).
#
# For Supabase use the *pooled* connection string (Session pooler, port 6543)
# from Project Settings > Database:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Attachment storage: "local" (development) or "supabase".
STORAGE_DRIVER=local

# Supabase Storage. Create a PRIVATE bucket named below, then copy these from
# Project Settings > API. The service role key bypasses row level security —
# server-side only, never expose it to the browser or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# "lax" when the API is served from the same origin as the app.
# "none" only when the API lives on a different domain (Safari blocks those).
COOKIE_SAMESITE=lax

# WhatsApp delivery driver.
#   mock  - messages stay inside Abiz; use /api/dev/inbound to simulate a customer
#   cloud - real Meta Cloud API calls (needs the per-company token in Settings)
WHATSAPP_DRIVER=mock

# Meta Cloud API. Graph version used for send calls.
META_GRAPH_VERSION=v21.0

# Credentials created by `npm run seed`. Local development only — the seed
# script refuses to run when NODE_ENV=production. Change these before exposing
# the app to anything outside your machine.
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin123
SEED_COMPANY_NAME=Abiz Store

# How long a password reset link stays valid.
RESET_TOKEN_TTL_MINUTES=30
